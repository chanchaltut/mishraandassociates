# ── Required ─────────────────────────────────────────────────
# MongoDB Atlas → Connect → Drivers → copy the connection string (put your DB password in it)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mishra?retryWrites=true&w=majority
# Any long random text (40+ characters). Render generates one automatically.
JWT_SECRET=change-me-to-a-long-random-string-of-40-plus-characters
# First admin account — created on first start
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=choose-a-strong-password

# ── Website ──────────────────────────────────────────────────
SITE_URL=https://mishraandassociates.in

# ── Optional integrations ────────────────────────────────────
# Cloudinary dashboard → "API environment variable" (cloudinary://key:secret@cloud)
CLOUDINARY_URL=
# Vercel → Project → Settings → Git → Deploy Hooks → create one for "main"
VERCEL_DEPLOY_HOOK_URL=
# resend.com → API Keys. Without a verified domain, alerts can only go to your Resend login email.
RESEND_API_KEY=
EMAIL_FROM=
# Emergency only: resets ADMIN_EMAIL's password on the next start. Remove afterwards.
RESET_ADMIN_PASSWORD=
